{
  "name": "mozetto",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @mozetto/web --filter @mozetto/api --filter @mozetto/game-server --filter @mozetto/agent-runtime --filter @mozetto/chain-indexer --filter @mozetto/dealer --filter @mozetto/replay-verifier --filter @mozetto/settlement-worker run dev",
    "dev:web": "pnpm --filter @mozetto/web dev",
    "dev:api": "pnpm --filter @mozetto/api dev",
    "dev:game": "pnpm --filter @mozetto/game-server dev",
    "dev:agent": "pnpm --filter @mozetto/agent-runtime dev",
    "dev:indexer": "pnpm --filter @mozetto/chain-indexer dev",
    "dev:admin": "pnpm --filter @mozetto/admin dev",
    "manifest:codegen": "pnpm --filter @mozetto/chain-manifest codegen",
    "test:contracts": "cd contracts && forge test -vv",
    "build": "pnpm -r run build",
    "db:migrate": "pnpm --filter @mozetto/database migrate",
    "typecheck": "pnpm -r run typecheck",
    "smoke:custody": "node ./scripts/anvil-custody-smoke.mjs",
    "smoke:custody:run": "node ./scripts/anvil-custody-smoke.mjs --run",
    "e2e:instant": "node ./scripts/anvil-e2e-instant-match.mjs",
    "e2e:arena-account": "node ./scripts/anvil-e2e-arena-account.mjs",
    "test:db": "pnpm --filter @mozetto/database test"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "viem": "^2.55.11"
  }
}
