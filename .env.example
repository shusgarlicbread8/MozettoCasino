# DATABASE_URL is REQUIRED for migrations, API, game-server, and V2 E2E.
# Prefer Supabase pooler (port 6543) — direct db.* host is often IPv6-only.
# Local alternative (docker compose): postgresql://mozetto:mozetto@127.0.0.1:5432/mozetto
#   pnpm bootstrap --docker-db
# Set DATABASE_SSL=0 for local Postgres without TLS.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# DATABASE_SSL=0


NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New API keys (Settings → API Keys). Do not use legacy anon / service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

DEMO_USER_ID=11111111-1111-1111-1111-111111111111
DEMO_AGENT_ID=22222222-2222-2222-2222-222222222222
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GAME_HTTP_URL=http://localhost:4001
NEXT_PUBLIC_GAME_WS_URL=ws://localhost:4001/ws
AGENT_RUNTIME_URL=http://localhost:4002
DEALER_URL=http://localhost:4003
DEALER_PORT=4003
# WP-054 Nitro enclave dealer scaffold (mock attestation for Anvil/local)
# ENCLAVE_ATTESTATION_MODE=mock|nitro  — nitro selects refusing stub; not a TEE claim
# DEALER_ENCLAVE_URL=http://localhost:4013
# DEALER_ENCLAVE_PORT=4013
# ENCLAVE_SIGNING_PRIVATE_KEY=   # local only; Anvil #8 in tests
REPLAY_VERIFIER_URL=http://localhost:4004
REPLAY_VERIFIER_PORT=4004
GAME_SERVER_PORT=4001
API_PORT=4000
AGENT_PORT=4002

# --- Groq Season 1 AI (WP-070 provider + WP-107 live table) ---
# Ranked Season 1 model is pinned to openai/gpt-oss-120b (see specs/MOZETTO_CONTROLLER_V1.md).
# Required for live Groq calls from @mozetto/agent-runtime. Never commit real keys.
# Offline unit tests / smoke mock mode do not need this variable.
# GROQ_API_KEY=
# Optional override (defaults to Groq OpenAI-compatible chat completions):
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
#
# WP-107 live table integration (game-server ↔ agent-runtime)
# AGENT_RUNTIME_MODE=auto          # auto|mock|live — auto uses Groq when GROQ_API_KEY is set
# AGENT_CADENCE_WAIT=client        # client|server|off — who sleeps for publicCadenceMs
# AGENT_CADENCE_WAIT_CAP_MS=       # optional smoke cap (ms); unset = WP-075 bounds only
# AI_CONTROLLER=agent-runtime      # agent-runtime|siliconflow|deterministic
# HUMAN_PLAY=0                     # 0 = autonomous AI seats (required for AI-only tables)
# AGENT_RUNTIME_OBSERVE=1          # set 0 to disable /v1/observe fan-out from game-server
# AGENT_MOCK_SEED=wp-107-mock      # ProfileMockProvider seed when mode=mock
#
# WP-129 ranked spectator WS delay (game-server). Players/owners unaffected.
# SPECTATOR_DELAY_MS=90000         # default 90000; set 0 to disable delay (local debug only)
#
# WP-111 economics instrumentation (COGS hypotheses — not GameTemplate freezes)
# ECONOMICS_LEDGER_PATH=./.data/economics-ledger.jsonl
# COGS_CHAIN_GAS_USD_MICRO=2000    # placeholder amortized USD micro per hand
# COGS_VRF_USD_MICRO=1500
# COGS_RELAYER_USD_MICRO=500
# COGS_CLOUD_USD_MICRO=3000

SESSION_SECRET=generate-a-long-random-string
WEB_ORIGIN=http://localhost:3000
# Comma-separated production web origins (Vercel URL). Used for CORS.
# WEB_ORIGINS=https://mozetto.vercel.app,https://mozetto-git-main-xxx.vercel.app
# Cross-site cookies when web (Vercel) ≠ API host — required for split deploy:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=1

# --- Dual worlds: Demo (email) vs On-chain (wallet SIWE) ---
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Local custody: MOZETTO_CHAIN_ENV=anvil + NEXT_PUBLIC_CHAIN_ENV=anvil
MOZETTO_CHAIN_ENV=base-sepolia
NEXT_PUBLIC_CHAIN_ENV=base-sepolia
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
ANVIL_RPC_URL=http://127.0.0.1:8545

# After forge deploy — paste addresses
NEXT_PUBLIC_ARENA_VAULT_ADDRESS=
ARENA_VAULT_ADDRESS=
NEXT_PUBLIC_ARENA_ACCOUNT_FACTORY_ADDRESS=
ARENA_ACCOUNT_FACTORY_ADDRESS=
ARENA_ACCOUNT_IMPLEMENTATION_ADDRESS=
ARENA_VAULT_V1_ADDRESS=
TABLE_REGISTRY_ADDRESS=
SETTLEMENT_HUB_ADDRESS=
# WP-084: PokerSettlementHubV3 (additive). When set, settlement-worker uses FinalSettlementV3.
# Force legacy Hub V2 demos with SETTLEMENT_HUB_VERSION=v2.
SETTLEMENT_HUB_V3_ADDRESS=
# SETTLEMENT_HUB_VERSION=v3
# HTTP attest-v3 (dealer + replay) is ON by default on the V3 path. Opt out:
# SETTLEMENT_V3_HTTP_ATTEST=0
# DEALER_URL → POST /v1/dealer/attest-v3 ; REPLAY_VERIFIER_URL → POST /v1/attest-settlement-v3
CHECKPOINT_REGISTRY_ADDRESS=
PROOF_BATCH_REGISTRY_ADDRESS=
# WP-085 proof-batch publisher (authorized ProofBatchRegistryV1.publisher)
# Anvil DeployLocal: publisher = deployer (Anvil #0). Prefer a dedicated key in prod.
# PROOF_BATCH_PUBLISHER_PRIVATE_KEY=
# PROOF_BATCH_INTERVAL_MS=3000
# PROOF_BATCH_DEMO_LEAVES=1
RANDOMNESS_COORDINATOR_ADDRESS=

FEE_TREASURY_ADDRESS=
PROTOCOL_FEE_VAULT_ADDRESS=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Session relayer — deploys ArenaAccounts, submits openSession, relays GamePermission txs
SESSION_RELAYER_PRIVATE_KEY=

# Seamless-play session signer — signs SeatTickets under ArenaAccount GamePermission.
# MUST be separate from SESSION_RELAYER_PRIVATE_KEY and SETTLEMENT_PRIVATE_KEY. Never expose to the browser.
INSTANT_SESSION_SIGNER_PRIVATE_KEY=

# Settlement worker (optional local Anvil / Sepolia publisher)
# Hub dedupes quorum by signer address — GAME/REPLAY/DEALER keys MUST be distinct.
# WP-065 (@mozetto/attestors): production / MOZETTO_PRODUCTION / CHAIN_ID=8453 refuse identical keys.
# Never reuse SETTLEMENT_PRIVATE_KEY as an attestor fallback.
# Anvil defaults that work with DeployLocal + setAttestor:
#   GAME   = Anvil #1  0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
#   REPLAY = Anvil #7  0x4bbbf85ce3377467afe5d46f804f221813b2bb87f24d81f60f1fcdbf7cbf4356
#   DEALER = Anvil #8  0xdbda1821b80551c9d65939329250298aa3472ba22feea921c0cf5d620ea67b97
# SETTLEMENT_PRIVATE_KEY submits hub.settle (can be relayer #0).
SETTLEMENT_PRIVATE_KEY=
GAME_ATTESTOR_PRIVATE_KEY=
REPLAY_ATTESTOR_PRIVATE_KEY=
DEALER_ATTESTOR_PRIVATE_KEY=
# ATTESTOR_REQUIRE_DISTINCT_KEYS=1
SETTLEMENT_POLL_MS=15000
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V2.5
CHAIN_ID=84532
ENABLE_MOCK_VRF=0
ANVIL_RPC_URL=http://127.0.0.1:8545

# --- WP-102 Base Sepolia deploy (names only; never commit secrets) ---
# Target is Base Sepolia (84532), not Ethereum Sepolia.
# Person-test cutover with mintable mUSDC:
#   1) Fund a non-Anvil PRIVATE_KEY with ≥0.05 ETH on Base Sepolia
#   2) USE_MOCK_USDC=1 pnpm sepolia:check && USE_MOCK_USDC=1 pnpm sepolia:deploy
#   3) Point local stack: MOZETTO_CHAIN_ENV=base-sepolia NEXT_PUBLIC_CHAIN_ENV=base-sepolia
#   4) Wallet page → Fund Arena Account (wallet signs faucet + transfer)
# Required for live broadcast: PRIVATE_KEY + BASE_SEPOLIA_RPC_URL (SEPOLIA_RPC_URL alias OK)
# PRIVATE_KEY=
# SEPOLIA_RPC_URL=                 # optional alias → BASE_SEPOLIA_RPC_URL
# BASESCAN_API_KEY=                # contract verification on Basescan
# USE_MOCK_USDC=1                  # mintable mUSDC for Base Sepolia person testing
# SETTLEMENT_HUB_V3_AS_PRIMARY=0   # 1 = vault.settlementHub = Hub V3
# WRITE_CHAIN_MANIFEST=0           # set by scripts/sepolia-deploy.sh broadcast only
# PROTOCOL_FEE_VAULT_MIN_DELAY=    # default 1 day (seconds)
# PROOF_BATCH_REGISTRY_MIN_DELAY=  # default 1 day
# GAME_REGISTRY_MIN_DELAY=0        # 0 required to activate templates in-script; raise post-deploy
# ATTESTOR_1_ADDRESS=
# ATTESTOR_2_ADDRESS=
# ATTESTOR_3_ADDRESS=
# ATTESTOR_MIN_SIGNATURES=1        # raise toward 3 before WP-103 public test
# GAME_REGISTRY_ADDRESS=
# SESSION_LIFECYCLE_ADDRESS=
# NEXT_PUBLIC_GAME_REGISTRY_ADDRESS=
# NEXT_PUBLIC_SESSION_LIFECYCLE_ADDRESS=
# NEXT_PUBLIC_RANDOMNESS_BEACON_ADDRESS=
# NEXT_PUBLIC_PROOF_BATCH_REGISTRY_ADDRESS=
# NEXT_PUBLIC_PROTOCOL_FEE_VAULT_ADDRESS=
# Recipes: pnpm sepolia:check | sepolia:dry-run | sepolia:deploy | sepolia:verify
# Docs: docs/WP-102_SEPOLIA_DEPLOYMENT.md

# --- WP-105 Restricted Base Mainnet (names only; NEVER broadcast from recipes) ---
# Live mainnet remains BLOCKED until Plan 14 gates + finalGateApproval.
# Docs: docs/WP-105_RESTRICTED_MAINNET.md | Checklist: scripts/mainnet/RESTRICTED_MAINNET_CHECKLIST.md
# Gate (expected FAIL today): pnpm mainnet:gate
# Manifest honesty: pnpm mainnet:check-manifest -- --honesty
# PRIVATE_KEY=                      # ops deployer only — not Anvil #0
# BASE_RPC_URL=                     # Base mainnet (8453); see above default
# BASESCAN_API_KEY=
# MOZETTO_MAINNET_FINAL_GATE_APPROVED=0  # must be 1 only after final gate
# USE_MOCK_USDC=0                   # FORBIDDEN=1 on mainnet
# ENABLE_MOCK_VRF=0                 # FORBIDDEN on mainnet
# WRITE_CHAIN_MANIFEST=0            # never set by WP-105 stub
# FEE_TREASURY_ADDRESS=             # Treasury Safe
# PROTOCOL_SAFE_ADDRESS=
# TREASURY_SAFE_ADDRESS=
# TIMELOCK_CONTROLLER_ADDRESS=
# ATTESTOR_1_ADDRESS=
# ATTESTOR_2_ADDRESS=
# ATTESTOR_3_ADDRESS=
# ATTESTOR_MIN_SIGNATURES=3
# MAINNET_ALLOWLIST_ENABLED=1
# MAINNET_MAX_BUY_IN_USDC=
# MAINNET_MAX_CONCURRENT_SESSIONS=
# Recipes: pnpm mainnet:check | mainnet:dry-run | mainnet:deploy (deploy refuses until gates)

# WP-053 Chainlink VRF v2.5 (Base Sepolia) — not required for unit tests / Anvil mock path
# Coordinator + key hash defaults: docs/WP-053_CHAINLINK_VRF.md / @mozetto/chain-manifest
# VRF_SUBSCRIPTION_ID=
