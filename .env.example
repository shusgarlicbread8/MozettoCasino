# VRF_REQUEST_CONFIRMATIONS=3
# VRF_NATIVE_PAYMENT=0
# CHAINLINK_VRF_ADAPTER_ADDRESS=
# RANDOMNESS_BEACON_ADDRESS=

# Chain indexer (WP-082 V3)
INDEXER_CONFIRMATIONS=3
INDEXER_POLL_MS=8000
INDEXER_RECONCILE_EVERY=30
INDEXER_HEALTH_PORT=4010
# Hosted platforms often set PORT — indexer/worker prefer PORT over *_HEALTH_PORT.
# INDEXER_REORG_LOOKBACK=64
# INDEXER_BLOCK_BATCH=2000
# INDEXER_REBUILD=1
# INDEXER_NET_WORTH_MS=60000
DEPLOYMENT_BLOCK=0

# Reconciliation worker (WP-083) — vault / fee-vault / session-mirror checks + auto-pause
# RECONCILE_POLL_MS=60000
# RECONCILE_HEALTH_PORT=4012
# RECONCILE_TOLERANCE_RAW=0
# Auto-pause defaults on for base / base-sepolia; force with RECONCILE_AUTO_PAUSE=1|0
# RECONCILE_AUTO_PAUSE=0

# Settlement worker health (WP-086); set SETTLEMENT_HEALTH=0 to disable HTTP
SETTLEMENT_HEALTH_PORT=4011
# SETTLEMENT_HEALTH=0

# Hosted deploy recipes (no live deploy required): docs/WP-086_HOSTED_DEPLOYMENT.md
#   render.yaml | deploy/fly/*.toml | docker-compose.hosted.yml

# Protocol / Treasury Safe metadata for WP-093 proposal builders (addresses only — never keys)
# PROTOCOL_SAFE_ADDRESS=0x…     # production 3-of-5 Protocol Safe
# TREASURY_SAFE_ADDRESS=0x…     # receive-only Treasury Safe
# TIMELOCK_CONTROLLER_ADDRESS=0x…  # optional OZ TimelockController owner
# Local defaults: mock Safe addresses in @mozetto/governance (not mainnet-deployed)

# Admin dashboard + protected API routes (WP-094 RBAC / MC-010 Control SIWE)
# Deploy apps/admin as a separate project; put hardware MFA/SSO in front in production.
# Never expose these via NEXT_PUBLIC_*. Prefer distinct read vs mutate tokens.
ADMIN_TOKEN=
# ADMIN_READ_TOKEN=          # viewer — GET admin APIs only
# ADMIN_MUTATE_TOKEN=        # operator — narrow privileged POST + audit log
# Optional actor label header for audit: x-admin-actor
#
# Mozetto Control wallet login (MC-010–015)
# ADMIN_SESSION_SECRET=      # signs mozetto_admin_session cookie (distinct from SESSION_SECRET)
# ADMIN_SESSION_TTL_HOURS=6
# ADMIN_SUPERADMIN_ADDRESSES=0xYourChecksummedWallet
# Local example wallet (env only — never hardcode in TS): 0x9a61916C0b312F5cD1150596f117A092166ed1ad
# Requires matching admin_principals row: subject = lower(address), disabled_at IS NULL
# ADMIN_SIWE_DOMAIN=localhost
# ADMIN_SIWE_URI=http://localhost:3001
# ADMIN_SIWE_CHAIN_ID=84532
# Table actor leases (WP-080) — multi-replica game-server fencing
# With REDIS_URL: Redis-backed leases (required for >1 replica).
# Without REDIS_URL: in-process memory leases (single replica only).
REDIS_URL=
# TABLE_LEASE_TTL_SEC=30
# TABLE_LEASE_WAIT_MS=30000
# TABLE_LEASE_ACTOR_ID=

# Persist-before-broadcast outbox (WP-081)
# OUTBOX_STORE=memory          # tests only; default = Postgres event_persistence_outbox
# CANONICAL_SCHEMA_KIND=legacy_json  # or poker_event_v1 when event type maps to PokerEventV1

# WP-106 / WP-108 golden Anvil RC (pnpm e2e:golden sets these for the orchestrator;
# restart game-server after changing so PokerEventV1 tips + HandRoots persist)
# CANONICAL_SCHEMA_KIND=poker_event_v1
# REQUIRE_REAL_ROOTS=1       # hard-fail keccak stub roots in settlement-worker
# MOZETTO_GOLDEN=1           # alias for REQUIRE_REAL_ROOTS (WP-106 golden path)
# HUMAN_PLAY=0               # autonomous AI seats for golden hands

# AgentState / Energy ledger persistence (WP-072 / WP-074 / WP-107 / WP-110)
# Default memory for local/dev. Set db when migration 026+ is applied on DATABASE_URL.
# LiveSessionManager + createCognitionScheduler persist AgentState + Energy when stores are wired.
# AGENT_STATE_STORE=memory     # or db|postgres|pg
# ENERGY_LEDGER_STORE=memory   # or db|postgres|pg

# Game WebSocket protocol emit (WP-110). Inbound always accepts legacy + v2 aliases.
# GAME_WS_EMIT_V2=0            # default: emit legacy frame names (hello, snapshot, event)
# GAME_WS_EMIT_V2=1            # emit Plan 19 names (hello_v2, snapshot_v2, canonical_event_v1, …)
# GAME_WS_PROTOCOL=legacy|v2   # alias for emit mode
