FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
# settlement-worker depends on @mozetto/dealer (workspace service)
COPY services/dealer ./services/dealer
COPY services/settlement-worker ./services/settlement-worker
RUN pnpm install --frozen-lockfile --filter @mozetto/settlement-worker...
ENV NODE_ENV=production
EXPOSE 4011
CMD ["pnpm", "--filter", "@mozetto/settlement-worker", "start"]
