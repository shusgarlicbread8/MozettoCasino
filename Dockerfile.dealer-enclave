# Parent host image for Mozetto dealer-enclave (WP-054).
# Runs the vsock/HTTP parent that talks to a Nitro enclave.
#
# Local / CI: this image runs the in-process MOCK runtime
#   (ENCLAVE_ATTESTATION_MODE=mock). It does NOT provide a TEE.
#
# Production: deploy on an EC2 Nitro-capable instance; launch the EIF
# via nitro-cli (see nitro/build.sh). Secrets stay inside the enclave.

FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY services/dealer-enclave ./services/dealer-enclave
RUN pnpm install --frozen-lockfile --filter @mozetto/dealer-enclave...
ENV NODE_ENV=production
ENV ENCLAVE_ATTESTATION_MODE=mock
EXPOSE 4013
CMD ["pnpm", "--filter", "@mozetto/dealer-enclave", "start"]
