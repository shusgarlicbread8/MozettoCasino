FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY services/replay-verifier ./services/replay-verifier
RUN pnpm install --frozen-lockfile --filter @mozetto/replay-verifier...
ENV NODE_ENV=production
EXPOSE 4004
CMD ["pnpm", "--filter", "@mozetto/replay-verifier", "start"]
