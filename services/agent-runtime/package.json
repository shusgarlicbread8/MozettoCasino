{
  "name": "@mozetto/agent-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider/index.ts",
    "./policy": "./src/policy/index.ts",
    "./state": "./src/state/index.ts",
    "./energy": "./src/energy/index.ts",
    "./cadence": "./src/cadence/index.ts",
    "./cognition": "./src/cognition/index.ts",
    "./eval": "./src/eval/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "start:local": "tsx --env-file=../../.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts src/**/**/*.test.ts",
    "eval:poker": "tsx src/eval/cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@mozetto/database": "workspace:*",
    "@mozetto/protocol-vectors": "workspace:*",
    "@mozetto/shared-types": "workspace:*",
    "fastify": "^5.2.1",
    "viem": "^2.55.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
