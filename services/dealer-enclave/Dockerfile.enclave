# Enclave build context stub (WP-054).
#
# ╔══════════════════════════════════════════════════════════════════╗
# ║  REQUIRES REAL AWS NITRO ENCLAVES TO PRODUCE A PRODUCTION EIF   ║
# ║  This Dockerfile alone does NOT create an attested TEE image.   ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# Intended flow on Amazon Linux 2023 + Nitro-enabled EC2:
#   1. Build this image as the enclave root filesystem
#   2. nitro-cli build-enclave --docker-uri … --output-file mozetto-dealer.eif
#   3. nitro-cli describe-eif --eif-path mozetto-dealer.eif  → publish PCRs
#   4. Attach KMS key policy to PCR0/PCR1/PCR2
#   5. nitro-cli run-enclave --eif-path … --cpu-count … --memory …
#
# Until those steps run on AWS, treat ENCLAVE_ATTESTATION_MODE=mock only.

FROM node:22-bookworm-slim AS enclave-root
WORKDIR /enclave
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
# Minimal copy — production builds should use a locked monorepo subset.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/dealer-deck ./packages/dealer-deck
COPY packages/protocol-vectors-ts ./packages/protocol-vectors-ts
COPY services/dealer-enclave ./services/dealer-enclave
RUN pnpm install --frozen-lockfile --filter @mozetto/dealer-enclave...
ENV ENCLAVE_ATTESTATION_MODE=nitro
ENV NODE_ENV=production
# Enclave entry: vsock listener (stub uses HTTP loopback for local mock only)
CMD ["pnpm", "--filter", "@mozetto/dealer-enclave", "start"]

# Note: `nitro-cli build-enclave` consumes the above image; there is no EIF
# artifact in this repository. Do not claim PCR measurements without describe-eif.
